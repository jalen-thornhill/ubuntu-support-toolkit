#!/usr/bin/sed -f

# I am inserting a report heading before the first input line.
1i\
Project Change Report

# I am copying the second input line into the hold space.
2h

# I am deleting that line from its original position.
2d

# I am appending the saved line after the third input line.
3G



# I am appending a blank line after the fourth input line.
4a\

# I am replacing every occurrence of modern with present-day on the lines reaching this command.
s/modern/present-day/g


# I am keeping only digits from the first input line, without changing the inserted heading.
1s/[^0-9]//g
