#!/usr/bin/nawk -f

# I am preparing the heading and deriving the monthly salary base from the project budget.
BEGIN{

print "LGS Employee Wages:- Week 6th - 10th October 2026"
print "Name Job-Code Weekly-Wage"

projectCst = 4600000
projectMonths = 2.5 * 12
baseMonthlySalary = (projectCst * 0.05) / projectMonths

}


# I am calculating hourly wages, with time and a half for hours beyond forty.
$3 == "LGS"{
if($5 <= 40){
wage = $4 * $5 
}

else {

regPay = $4 * 40

overtimePay = ($5 - 40) * $4 * 1.5

wage = regPay + overtimePay



  # I am thanking and counting employees who worked overtime.
  if ($5 > 40) {
    print "Thanks for the extra effort", $1
    overtimeCnt++
  }
}

print $1, $2, $3, wage






}

# I am calculating project-based monthly salaries for engineers and managers.
$3== "ENG" || $3 == "MGR" {

monthlySalary = baseMonthlySalary


# I am applying a two-percent increase when an engineer meets both qualification checks.
if($3 == "ENG" && $6 >= 10 && $5 > 35) {

	monthlySalary = monthlySalary * 1.02
}




# I am storing each salaried employee's details and accumulating their predicted pay.
salaryCnt++
employeeName[salaryCnt] = $1 " " $2
jobCode[salaryCnt] = $3
predictedSalary[salaryCnt] = monthlySalary 
salaryTotal = salaryTotal + monthlySalary

}


# I am displaying the overtime count and stored salary predictions.
END {
  print overtimeCnt, "LGS employees worked overtime this week"
  print ""

  print "Projected Salary for Engineers(ENG) and Managers(MGR) for October"
  print "Name Job-Code Monthly-Salary"

  for (employee = 1; employee <= salaryCnt; employee++) {
    print employeeName[employee], jobCode[employee], predictedSalary[employee]
  }

  # I am calculating the average, assuming at least one salaried employee was counted.
  averageSalary = salaryTotal / salaryCnt
  print "Average predicted Salary:", averageSalary
}


