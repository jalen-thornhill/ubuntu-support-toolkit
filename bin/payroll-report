#!/usr/bin/nawk -f

BEGIN{

print "LGS Employee Wages:- Week 6th - 10th October 2026"
print "Name Job-Code Weekly-Wage"

projectCst = 4600000
projectMonths = 2.5 * 12
baseMonthlySalary = (projectCst * 0.05) / projectMonths

}


$3 == "LGS"{
if($5 <= 40){
wage = $4 * $5 
}

else {

regPay = $4 * 40

overtimePay = ($5 - 40) * $4 * 1.5

wage = regPay + overtimePay



  if ($5 > 40) {
    print "Thanks for the extra effort", $1
    overtimeCnt++
  }
}

print $1, $2, $3, wage






}

$3== "ENG" || $3 == "MGR" {

monthlySalary = baseMonthlySalary


if($3 == "ENG" && $6 >= 10 && $5 > 35) {

	monthlySalary = monthlySalary * 1.02
}




salaryCnt++
employeeName[salaryCnt] = $1 " " $2
jobCode[salaryCnt] = $3
predictedSalary[salaryCnt] = monthlySalary 
salaryTotal = salaryTotal + monthlySalary

}


END {
  print overtimeCount, "LGS employees worked overtime this week"
  print ""

  print "Projected Salary for Engineers(ENG) and Managers(MGR) for October"
  print "Name Job-Code Monthly-Salary"

  for (employee = 1; employee <= salaryCnt; employee++) {
    print employeeName[employee], jobCode[employee], predictedSalary[employee]
  }

  averageSalary = salaryTotal / salaryCnt
  print "Average predicted Salary:", averageSalary
}


